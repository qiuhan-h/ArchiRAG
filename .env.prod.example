# ArchiRAG 生产环境配置
# 复制为 .env 后填写真实值

# ===== LLM：Qwen（阿里云 DashScope）=====
QWEN_API_KEY=                      # ← 填你的 DashScope API Key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
LLM_TEMPERATURE=0.1

# ===== Embedding（bge-large-zh-v1.5）=====
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DEVICE=cpu
FALLBACK_EMBED_DIM=1024

# ===== FAISS =====
FAISS_INDEX_PATH=/app/data/faiss_index
TOP_K=8

# ===== MySQL（生产密码）=====
MYSQL_ROOT_PASSWORD=                # ← 填强密码
MYSQL_URL=mysql+pymysql://root:CHANGE_ME@db:3306/building_rag
SQLITE_PATH=/app/data/building_rag.db

# ===== Redis（生产密码）=====
REDIS_PASSWORD=                    # ← 填强密码（留空则无密码）
REDIS_URL=redis://:CHANGE_ME@redis:6379/0
CACHE_TTL=3600

# ===== 文件监控 =====
WATCH_DIR=/app/data/raw

# ===== 运行模式 =====
APP_ENV=prod
