# ===== LLM：Qwen（阿里云 DashScope，OpenAI 兼容模式）=====
# 留空时自动降级为本地抽取式 FakeLLM，全链路仍可跑通
QWEN_API_KEY=sk-your-dashscope-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
LLM_TEMPERATURE=0.1

# ===== Embedding =====
# 真实模型（需 pip install -r requirements-embed.txt，首次自动下载约 1.3GB）
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DEVICE=cpu
# 降级 Embedder 的向量维度（仅在 sentence-transformers 不可用时生效）
FALLBACK_EMBED_DIM=1024

# ===== FAISS 向量库 =====
FAISS_INDEX_PATH=./data/faiss_index
TOP_K=8

# ===== MySQL（严格按方案；连不上时自动降级 SQLite）=====
MYSQL_URL=mysql+pymysql://root:root@localhost:3306/building_rag
SQLITE_PATH=./data/building_rag.db

# ===== Redis（严格按方案；连不上时自动降级进程内 TTL 缓存）=====
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# ===== 文件监控 + 增量同步 =====
WATCH_DIR=./data/raw

# ===== 运行模式 =====
# dev：允许降级并打印告警；prod：关键依赖缺失将拒绝启动
APP_ENV=dev
